<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is allowed here; api/ServerUrl.parse enforces the private-address rule for http (spec 8.5). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
