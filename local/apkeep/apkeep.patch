+// fork: one probe session request. `details` -> latest versionCode/versionString; `<versionCode>` -> purchase + delivery
+// URLs, no download. notFound = gpapi InvalidApp (purchase gave no delivery token, or delivery has no appDeliveryData).
+async fn probe(gpa: &Gpapi, app_id: &str, request: &str) -> serde_json::Value {
+    let mode = if request == "details" { "details" } else { "delivery" };
+    let fail = |not_found: bool, text: String| serde_json::json!({"pkg": app_id, "mode": mode, "ok": false, "notFound": not_found, "error": text});
+    if mode == "details" {
+        return match gpa.details(app_id).await {
+            Err(e) => fail(false, format!("details: {}", e)),
+            Ok(d) => match d.and_then(|d| d.item).and_then(|i| i.details).and_then(|d| d.app_details) {
+                Some(a) if a.version_code.is_some() => serde_json::json!({"pkg": app_id, "mode": mode, "ok": true,
+                    "versionCode": a.version_code, "versionString": a.version_string.unwrap_or_default()}),
+                _ => fail(true, String::from("details: no appDetails versionCode")),
+            },
+        };
+    }
+    let vc = match request.parse::<i64>() {
+        Ok(vc) => vc,
+        Err(e) => return fail(false, format!("expected a line `details` or a decimal versionCode, got {:?}: {}", request, e)),
+    };
+    let mut v = match gpa.get_download_info(app_id, Some(vc)).await {
+        Ok((Some(url), splits, _, _)) => serde_json::json!({"pkg": app_id, "mode": mode, "ok": true, "url": url,
+            "splits": splits.into_iter().map(|(name, url)| serde_json::json!({"name": name, "url": url})).collect::<Vec<_>>()}),
+        Ok((None, _, _, _)) => fail(false, String::from("delivery: ok but no base download URL")),
+        Err(e) if matches!(e.kind(), GpapiErrorKind::InvalidApp) => fail(true, format!("delivery: {}", e)),
+        Err(e) => fail(false, format!("delivery: {}", e)),
+    };
+    v["vc"] = vc.into();
+    v
 }
