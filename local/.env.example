# Copy to local/.env and edit (spec core §1, §12).
# Before the first `docker compose -f local/docker-compose.yml up -d --build`, as the user that owns the repo:
#   mkdir -p local/data/work local/data/apk-cache local/data/upstream   # Compose does not create them
#   touch local/data/github_token       # may stay empty = unauthenticated GitHub (60 requests/hour)
# With another RV_DATA_DIR create the same subdirectories there; local/data must still exist (hidden from /repo).
# Keep the token outside src/: build children (third-party patch code) can read the repo mount.
# Linux host / NAS: host (mDNS phone discovery). macOS Docker Desktop: bridge (manual phone IP:port).
RV_NETWORK_MODE=host
# Web UI port published in bridge mode (host mode always uses 47000)
RV_WEB_PORT=47000
# Data directory (database, logs, artifacts, caches, adb keys), relative to local/
RV_DATA_DIR=./data
# Linux: your uid and gid (id -u, id -g) so local/data stays yours. macOS: leave empty.
RV_UID=
RV_GID=
TZ=UTC
# GitHub token file (fine-grained, public repositories read-only), relative to local/
RV_GITHUB_TOKEN_FILE=./data/github_token
