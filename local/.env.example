# Copy to local/.env and edit (spec core §1, §12).
# Before the first `docker compose -f local/docker-compose.yml up -d --build`, as the user that owns the repo:
#   mkdir -p local/key   # Compose does not create it (the adb key must never be silently recreated)
# RELUME_DATA_DIR needs no preparation: everything in it regrows from an empty or missing folder.
# Linux host / NAS: host (mDNS phone discovery). macOS Docker Desktop: bridge (manual phone IP:port).
RELUME_NETWORK_MODE=host
# Web UI port published in bridge mode (host mode always uses 47000)
RELUME_WEB_PORT=47000
# Data directory (database, logs, artifacts, APK outputs, caches, upstream downloads, work), relative to local/. Safe to delete.
RELUME_DATA_DIR=./data
# Key directory (adb key, GitHub token entered on the Settings page), relative to local/. Must exist. Back it up: deleting it re-authorizes every paired phone.
RELUME_KEY_DIR=./key
# Linux: your uid and gid (id -u, id -g) so local/data and local/key stay yours. macOS: leave empty.
RELUME_UID=
RELUME_GID=
TZ=UTC
# GitHub token file (fine-grained, public repositories read-only), relative to local/
# Optional; the token can be entered on the Settings page instead. If set, the file must exist. Build children (third-party patch
# code) must not read it: it is mounted only for the server, never into /repo.
#RELUME_GITHUB_TOKEN_FILE=./key/github_token
