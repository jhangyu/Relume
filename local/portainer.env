# Variables for local/docker-compose-portainer.yml (Portainer: Stacks > Add stack > Environment variables > Load variables from .env file).
# Required: absolute host directory for everything that regrows from an empty folder (database, logs, artifacts, caches, upstream, work); safe to delete
RELUME_DATA_DIR=/Users/jhangyu/project/relume/local/data
# Required: absolute host directory for what must survive (adb key, GitHub token); must exist, back it up
RELUME_KEY_DIR=/Users/jhangyu/project/relume/local/key
# Required: host directory holding fiorenmas.ks, lspatch-signing.p12 and morphe.keystore (only these three files are mounted)
RELUME_KEYSTORE_DIR=/Users/jhangyu/project/relume/src/keystore/
# host on a Linux host (mDNS phone discovery); bridge on Docker Desktop (macOS/Windows, add phones by IP:port)
RELUME_NETWORK_MODE=host
# Published web port, bridge mode only (host mode always uses 47000)
RELUME_WEB_PORT=47000
# Server uid:gid inside the container; Docker Desktop (macOS) needs no host ownership, keep 0. Linux: set the owner of RELUME_DATA_DIR
RELUME_UID=0
RELUME_GID=0
TZ=Asia/Taipei
